{
  "id": "claude-remote",
  "name": "Claude Remote",
  "version": "1.5.4",
  "minNoctaliaVersion": "3.6.0",
  "author": "Jack Vanlint <277274540+jackvanlint@users.noreply.github.com>",
  "description": "Runs claude remote-control in the background and shows live status in the bar",
  "tags": ["Bar", "Panel", "Development"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "sessionName": "Remote Session",
      "claudeBin": "claude",
      "terminalBin": "kitty",
      "workspaceDir": "~",
      "autoStart": true,
      "showUsage": true,
      "favouriteSkills": []
    }
  }
}
